# ==============================================================================
# SCOLAPRO v2.5 — MODÈLE DE CONFIGURATION D'ENVIRONNEMENT (.env.example)
# ÉDITÉ ET CONÇU PAR : INNOVA GROUP
# ==============================================================================
# INSTRUCTIONS :
# 1. Dupliquez ce fichier vers '.env' : cp .env.example .env
# 2. Renseignez vos identifiants et clés d'API réels dans '.env'
# 3. Ne committez JAMAIS le fichier '.env' dans Git !
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICATION DE L'APPLICATION & ENVIRONNEMENT
# ------------------------------------------------------------------------------
APP_NAME="ScolaPro"
APP_BRAND="INNOVA GROUP"
APP_DESCRIPTION="Plateforme Intégrée de Gestion Scolaire & Architecture Multi-Tenant"
APP_ENV=production
APP_DEBUG=false
APP_VERSION="2.5.0"
APP_LOCALE=fr
APP_TIMEZONE="Africa/Abidjan"
APP_URL="https://scolapro.innovagroup.ci"
PORT=3000

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL 14+ (Multi-Tenant & Conformité schema.sql)
# ------------------------------------------------------------------------------
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=scolapro_db
DB_USERNAME=postgres_user
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public
DB_SSL=true

# Chaîne de connexion unifiée
DATABASE_URL="postgresql://postgres_user:your_secure_password_here@127.0.0.1:5432/scolapro_db?schema=public&sslmode=require"

DB_POOL_MIN=5
DB_POOL_MAX=25
DB_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Optionnel / Backend BaaS Cloud)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ RBAC, SESSIONS & CRYPTOGRAPHIE (Certifié RG-11)
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-strong-random-secret-key-at-least-32-characters"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Token maître de souveraineté Concepteur SaaS (Niveau 1)
CONCEPTEUR_MASTER_KEY="generate-secure-concepteur-master-token-here"

APP_KEY="base64:generate-with-openssl-rand-base64-32"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_COOKIE_NAME="__Secure-scolapro_session"
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS="https://scolapro.innovagroup.ci,https://app.scolapro.ci"

# ------------------------------------------------------------------------------
# 5. PARAMÈTRES MULTI-TENANT & ISOLATION HIÉRARCHIQUE
# ------------------------------------------------------------------------------
ENABLE_MULTI_TENANT=true
DEFAULT_TENANT_TYPE="SCHOOL"
DEFAULT_SCHOOL_ID=
DEFAULT_SCHOOL_CODE=
DEFAULT_FOUNDATION_ID=
DEFAULT_FOUNDATION_CODE=
ALLOW_ANONYMOUS_SCHOOL_GENERATOR=false

# ------------------------------------------------------------------------------
# 6. PASSERELLE SMS (Relances Automatisées d'Écolage & Alertes Absences)
# ------------------------------------------------------------------------------
SMS_PROVIDER=orange_ci
SMS_SENDER_ID="ScolaPro"
SMS_API_URL="https://api.orange.com/smsmessaging/v1"
SMS_CLIENT_ID="your_orange_sms_client_id"
SMS_CLIENT_SECRET="your_orange_sms_client_secret"
SMS_ENABLED=true

# ------------------------------------------------------------------------------
# 7. SERVEUR E-MAIL / SMTP (Reçus de Paiement & Convocations Officielles)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME="apikey"
MAIL_PASSWORD="your_sendgrid_api_key"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@innovagroup.ci"
MAIL_FROM_NAME="ScolaPro by INNOVA GROUP"

# ------------------------------------------------------------------------------
# 8. PASSERELLES DE PAIEMENT MOBILE MONEY (Écolage & Caisse Centrale)
# ------------------------------------------------------------------------------
WAVE_API_URL="https://api.wave.com/v1"
WAVE_API_KEY="your_wave_live_api_key"
WAVE_WEBHOOK_SECRET="your_wave_webhook_secret"

ORANGE_MONEY_MERCHANT_KEY="your_orange_money_merchant_key"
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/v1"

MTN_MOMO_PRIMARY_KEY="your_mtn_momo_primary_key"
MTN_MOMO_API_URL="https://momodeveloper.mtn.com"

# ------------------------------------------------------------------------------
# 9. STOCKAGE DE FICHIERS (Logos Écoles, Fiches A4, Bulletins, Justificatifs)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH="./uploads"
MAX_UPLOAD_SIZE_MB=15

AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="af-south-1"
AWS_BUCKET="scolapro-production-storage"
AWS_ENDPOINT=""

# ------------------------------------------------------------------------------
# 10. JOURNALISATION & PISTE D'AUDIT RG-11
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_FILE="./logs/scolapro.log"
AUDIT_TRAIL_ENABLED=true
AUDIT_RETENTION_DAYS=365
