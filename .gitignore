# ==============================================================================
# SCOLAPRO — RÈGLES D'EXCLUSION GIT (.gitignore)
# ÉDITÉ PAR : INNOVA GROUP
# ==============================================================================

# 1. Fichiers d'environnement et secrets sensibles
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Secrets, clés privées, tokens et certificats
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.secret
*credentials*.json
service-account*.json
secrets/

# 2. Dépendances Node.js et paquetages
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Journaux et logs d'exécution
logs/
*.log
npm-debug.log*

# 4. Fichiers temporaires d'éditeurs et OS
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# 5. Répertoires de téléversement et uploads locaux
uploads/*
!uploads/.gitkeep
temp/
dist/
build/

# 6. Fichiers de couverture de test et caches
coverage/
.nyc_output/
.cache/

# 7. Bases de données SQLite locales et fichiers WAL
*.db
*.db-*
*.sqlite
*.sqlite3

