{
  "name": "scolapro",
  "version": "2.5.0",
  "description": "Plateforme SaaS Multi-Tenant de Gestion Scolaire & Financière (UEMOA / MENA)",
  "author": "INNOVA GROUP",
  "license": "UNLICENSED",
  "private": true,
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "echo 'ScolaPro static build ready'",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:security": "node --test tests/security_auth.test.js",
    "test:rbac": "node --test tests/rbac_isolation.test.js",
    "test:financial": "node --test tests/financial_acid.test.js",
    "test:xss": "node --test tests/xss_output.test.js",
    "lint": "node --check server.js db.js config.js lib/auth.js lib/rbac.js lib/http-security.js scripts/set-password.js",
    "auth:set-password": "node scripts/set-password.js",
    "db:sanitize": "node -e \"require('./db.js').sanitizeProductionDatabase()\""
  },
  "keywords": [
    "saas",
    "edtech",
    "multi-tenant",
    "school-management",
    "fintech",
    "africa",
    "uemoa",
    "syscohada"
  ]
}
